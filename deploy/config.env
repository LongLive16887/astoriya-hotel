# Production server settings used by the GitHub Actions workflows. No secrets here: SSH access
# comes from the repository secrets VPS_HOST, VPS_USER, VPS_SSH_KEY (or SERVER_SSH_PASSWORD).

SERVER_HOST=13.140.177.106

# inspect: the Server setup workflow only looks at the server (an encrypted report in its log).
# install: it installs or updates everything the site needs, then the current build.
SETUP_MODE=install

# Web server in front of the site: empty to detect (nginx when it already serves ports 80/443,
# otherwise Caddy), or nginx / caddy.
WEB=

# Site domain without "www", e.g. astoria-samarkand.uz. Its DNS A record must point to SERVER_HOST.
# While it is empty, the site runs on the server but nginx does not publish it (with Caddy on a
# server of its own, it answers on http://SERVER_HOST).
DOMAIN=astoriya.uz

# 1: also answer on www.<DOMAIN> (redirects to the domain; needs an A record for www too).
WWW=1

# Login of the first admin, created on the first setup. Its password is printed in the setup
# log encrypted with deploy/server/bootstrap.pub, so only the holder of the private key can read it.
ADMIN_EMAIL=admin@astoria.local
