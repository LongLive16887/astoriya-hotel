# Production server settings used by the GitHub Actions workflows. No secrets here:
# the root password is the repository secret SERVER_SSH_PASSWORD.

SERVER_HOST=13.140.177.106

# Site domain without "www", e.g. astoria-samarkand.uz. Its DNS A record must point to SERVER_HOST.
# While it is empty the site answers on http://SERVER_HOST.
DOMAIN=

# 1: also answer on www.<DOMAIN> (redirects to the domain; needs an A record for www too).
WWW=1

# Login of the first admin, created on the first setup. Its password is printed in the setup
# log encrypted with deploy/server/bootstrap.pub, so only the holder of the private key can read it.
ADMIN_EMAIL=admin@astoria.local
