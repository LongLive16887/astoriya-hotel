# Managed by deploy/server/setup.sh: changes made here are replaced on the next setup.

(astoria) {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:3001 {
			# Server-Sent Events for the admin panel must not be buffered.
			flush_interval -1
		}
	}

	handle_path /uploads/* {
		root * /var/lib/astoria/uploads
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Hashed build files never change; a missing one is a 404, not the page.
	handle /assets/* {
		root * /opt/astoria/current/dist
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle /images/* {
		root * /opt/astoria/current/dist
		header Cache-Control "public, max-age=604800"
		file_server
	}

	handle {
		root * /opt/astoria/current/dist
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
