# Скопируйте этот файл в .env и заполните значения
# (или задайте те же переменные в настройках хостинга).
# Где взять: Firebase Console → Project settings → General → Your apps → Web app → SDK setup and configuration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Адрес сайта без «/» в конце, например https://astoria.uz — нужен для превью ссылок в Telegram, Facebook и т. п.
VITE_SITE_URL=

# Необязательно: загружать фото из админки в Cloudinary вместо Firebase Storage
# (Cloudinary → Settings → Upload → Upload presets → пресет с режимом «Unsigned»).
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
